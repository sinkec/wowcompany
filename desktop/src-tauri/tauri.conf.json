{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WowCompany Companion",
	"version": "0.1.1",
	"identifier": "app.wowcompany.companion",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "WowCompany Companion",
				"width": 960,
				"height": 680,
				"minWidth": 760,
				"minHeight": 540
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Game",
		"shortDescription": "Dungeon run tracker for WowCompany",
		"longDescription": "Reads your WoW combat log, detects dungeon runs and uploads the party's stats to the WowCompany portal.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
